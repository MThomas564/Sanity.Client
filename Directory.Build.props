<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Shared NuGet package metadata for Sanity.Client and Sanity.Client.Presentation. -->
  <PropertyGroup>
    <Authors>Matthew Thomas</Authors>
    <Company>Matthew Thomas</Company>
    <Copyright>Copyright (c) 2026 Matthew Thomas</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MThomas564/Sanity.Client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MThomas564/Sanity.Client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Version comes from MinVer (git tags), not a hand-set property:
         see the PackageReference below and RELEASING.md. Tag v0.1.0 for a
         release; untagged commits after it automatically become
         0.1.1-preview.0.<height>. ContinuousIntegrationBuild enables
         deterministic/reproducible builds (paired with embedded
         SourceLink) only when actually running in CI. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Treat warnings as errors only in CI: keeps local inner-loop
         builds from being blocked by a warning while you're mid-edit,
         while still gating merges on a warning-free build. -->
    <TreatWarningsAsErrors Condition="'$(GITHUB_ACTIONS)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- MinVer: derives Version from git tags (the single source of
         truth for versioning, see RELEASING.md). Needs the repo's full
         tag history, i.e. `fetch-depth: 0` in CI checkout steps; a
         shallow clone silently produces a wrong (0.0.0-prefixed)
         version instead of failing loudly, so don't skip that. -->
    <PackageReference Include="MinVer" Version="5.0.0" PrivateAssets="All" />
  </ItemGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

</Project>
