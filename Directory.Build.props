<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Shared NuGet package metadata for Sanity.Client and Sanity.Client.Presentation. -->
  <PropertyGroup>
    <Authors>Matthew Thomas</Authors>
    <Company>Matthew Thomas</Company>
    <Copyright>Copyright (c) 2025 Matthew Thomas</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MThomas564/SanityClient</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MThomas564/SanityClient</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <!-- SourceLink: lets consumers step into this package's source from a
       debugger, and stamps the exact commit into the built assembly.
       Harmless to apply repo-wide; it only does anything for projects
       that actually get packed/published with symbols. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- 8.0.0 pulls Microsoft.Build.Tasks.Git 8.0.0, flagged by
         GHSA-23fw-v26w-5fgq (CVE-2026-62900); 10.0.401 is the lowest
         stable version clear of it. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

</Project>
