<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Shared NuGet package metadata for Sanity.Client and Sanity.Client.Presentation. -->
  <PropertyGroup>
    <Authors>Matthew Thomas</Authors>
    <Company>Matthew Thomas</Company>
    <Copyright>Copyright (c) 2026 Matthew Thomas</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MThomas564/Sanity.Client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MThomas564/Sanity.Client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- First public release: a preview suffix until the API has had real
         external usage. Drop the suffix for the 0.1.0 (or later) GA tag. -->
    <Version>0.1.0-preview.1</Version>
  </PropertyGroup>

</Project>
