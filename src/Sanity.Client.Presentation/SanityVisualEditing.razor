@implements IAsyncDisposable
@inject ISanityPresentationService Presentation

@* Renders nothing itself; just enables/disables overlays as Enabled changes. *@

@code {
    /// <summary>
    /// Whether overlays should be active. Bind this to your app's draft
    /// mode / preview flag -- e.g. a query string flag set by the
    /// Presentation tool, or a cookie. Keep this false in production
    /// unless you're actually being previewed.
    /// </summary>
    [Parameter]
    public bool Enabled { get; set; }

    /// <summary>
    /// Called when the Presentation tool reports content changed and the
    /// preview should update (see
    /// <see cref="ISanityPresentationService.EnableVisualEditingAsync"/>).
    /// Typically you'll re-fetch with <see cref="SanityPerspective.Drafts"/>
    /// and call <c>StateHasChanged()</c> on whatever component owns the
    /// data, then return true. Leave unset to let Sanity fall back to its
    /// own default handling.
    /// </summary>
    [Parameter]
    public Func<SanityRefreshPayload, Task<bool>>? OnRefresh { get; set; }

    private bool _currentlyEnabled;

    protected override async Task OnParametersSetAsync()
    {
        if (Enabled == _currentlyEnabled)
        {
            return;
        }

        if (Enabled)
        {
            await Presentation.EnableVisualEditingAsync(OnRefresh);
        }
        else
        {
            await Presentation.DisableVisualEditingAsync();
        }

        _currentlyEnabled = Enabled;
    }

    public async ValueTask DisposeAsync()
    {
        if (_currentlyEnabled)
        {
            await Presentation.DisableVisualEditingAsync();
        }
    }
}
