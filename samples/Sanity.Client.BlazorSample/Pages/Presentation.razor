@page "/presentation"
@inject ISanityClient Sanity
@inject ISanityPresentationService PresentationService

<PageTitle>Presentation / Visual Editing — Sanity.Client sample</PageTitle>

<SanityVisualEditing Enabled="@_overlaysEnabled" OnRefresh="HandleRefreshAsync" />

<h1>Presentation tool / Visual Editing</h1>

<p>
    This page demonstrates <code>Sanity.Client.Presentation</code>: fetching
    with a Content Source Map, stega-encoding the result for click-to-edit,
    enabling the overlay script, and wiring the <code>refresh</code>
    callback that drives live preview updates when content changes in the
    Studio -- all served from this app's own static web assets
    (<code>_content/Sanity.Client.Presentation/...</code>), no third-party
    CDN involved.
</p>

<p class="alert alert-info">
    Stega encoding only powers <strong>click-to-edit</strong> (mapping
    rendered text back to its source field). It does <strong>not</strong>
    make the preview update live. That's what the <code>OnRefresh</code>
    callback below is for: it's called whenever the Presentation tool
    reports a mutation, so you can re-fetch and re-render in place --
    <strong>with the <code>Drafts</code> perspective</strong>, since
    without it the re-fetch would just return the same published content
    again and an unpublished edit would never show up (this was feedback
    from Sanity's own team: live updates in Presentation require querying
    drafts, not published). This sample's public demo dataset happens to
    allow anonymous draft reads; your own dataset almost certainly
    requires a read token for this (see the
    <a href="https://www.sanity.io/docs/visual-editing/implementing-draft-mode">
    Draft Mode docs</a> for the recommended secret-gated, server-side-only
    token pattern -- never put that token in a Blazor WASM app's config).
</p>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_movie is null)
{
    <p><em>Loading&hellip;</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">Perspective</dt>
        <dd class="col-sm-9">
            <code>@(_overlaysEnabled ? "drafts" : "published")</code>
            @(_overlaysEnabled
                ? " -- querying drafts because overlays are on"
                : " -- querying published because overlays are off")
        </dd>

        <dt class="col-sm-3">Title (raw)</dt>
        <dd class="col-sm-9">@_movie.Title</dd>

        <dt class="col-sm-3">Title (stega-encoded)</dt>
        <dd class="col-sm-9">
            <code>@_encodedMovie!.Title.Length</code> chars
            (@(_encodedMovie.Title.Length - _movie.Title.Length) invisible characters added)
        </dd>

        <dt class="col-sm-3">Cleaned back</dt>
        <dd class="col-sm-9">
            "@_cleanedTitle" ==
            <code>@(_cleanedTitle == _movie.Title ? "matches original ✅" : "MISMATCH ❌")</code>
        </dd>
    </dl>

    <button class="btn btn-primary" @onclick="ToggleOverlays">
        @(_overlaysEnabled ? "Disable" : "Enable") visual editing overlays
    </button>
    <p class="text-muted mt-2">
        @(_overlaysEnabled
            ? "Overlays enabled: @sanity/visual-editing-standalone was loaded, enableVisualEditing() called, and the refresh callback wired to HandleRefreshAsync below."
            : "Overlays are off.")
    </p>

    @if (_refreshLog.Count > 0)
    {
        <h4 class="mt-4">Refresh events received</h4>
        <ul>
            @foreach (var entry in _refreshLog)
            {
                <li>@entry</li>
            }
        </ul>
    }
}

@code {
    private Movie? _movie;
    private Movie? _encodedMovie;
    private string? _cleanedTitle;
    private string? _error;
    private bool _overlaysEnabled;
    private readonly List<string> _refreshLog = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadMovieAsync();
    }

    private async Task LoadMovieAsync()
    {
        const string query = """
            *[_type == "movie"] | order(popularity desc) [0]{
              _id, _type, _rev, _createdAt, _updatedAt, title, popularity, releaseDate,
              "posterUrl": poster.asset->url
            }
            """;

        try
        {
            // Drafts perspective while visual editing is on: this is the
            // whole point of "live updates" in Presentation -- without
            // it, OnRefresh's re-fetch below would just return the same
            // published content again, and an edit made in the Studio
            // (which isn't published yet) would never show up. The SDK
            // auto-routes Drafts off the CDN for you (the CDN flatly
            // rejects perspective), so you don't need UseCdn = false too.
            var options = new SanityFetchOptions
            {
                ResultSourceMap = SanitySourceMapMode.WithKeyArraySelector,
                Perspective = _overlaysEnabled ? SanityPerspective.Drafts : null,
            };

            var result = await Sanity.FetchAsync<Movie>(query, options: options);

            _movie = result.Result;
            if (_movie is not null)
            {
                _encodedMovie = await PresentationService.StegaEncodeAsync(_movie, result.ResultSourceMap);
                _cleanedTitle = await PresentationService.StegaCleanAsync(_encodedMovie.Title);
            }
        }
        catch (Exception ex) when (ex is SanityException or JSException)
        {
            _error = $"Failed to load/encode movie: {ex.Message}";
        }
    }

    /// <summary>
    /// Called by Sanity.Client.Presentation whenever the Presentation tool
    /// reports a mutation or a manual refresh request. Re-fetches and
    /// re-renders, then returns true to tell Sanity it was handled.
    /// </summary>
    private async Task<bool> HandleRefreshAsync(SanityRefreshPayload payload)
    {
        var description = payload.Source == "mutation" && payload.Document is not null
            ? $"mutation on {payload.Document.Type}/{payload.Document.Id} (rev {payload.Document.Rev})"
            : $"source={payload.Source}";

        _refreshLog.Insert(0, $"{DateTime.Now:HH:mm:ss.fff} — {description}");

        await LoadMovieAsync();
        StateHasChanged();
        return true;
    }

    private async Task ToggleOverlays()
    {
        _overlaysEnabled = !_overlaysEnabled;
        await LoadMovieAsync();
    }
}
